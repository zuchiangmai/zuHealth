<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>PhysiMind</string>
	<key>CFBundleName</key>
	<string>PhysiMind</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).physimind</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>physimind</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan a lab device&apos;s code or another device&apos;s link code, and photograph lab reports.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>PhysiMind reads your steps, heart rate, sleep, body measurements and more from Apple Health and keeps them with your other health data, on this device and your other devices.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>PhysiMind adds the body composition measured in the lab (weight, height, BMI, body fat, lean body mass, waist) to Apple Health.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sync health data directly with your other devices on the same network.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos of lab reports for PhysiMind to read on this device.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>