{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhysiMind",
  "version": "0.1.0",
  "identifier": "com.zuchiangmai.health",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhysiMind",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "HealthcareAndFitness",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "iOS": {
      "minimumSystemVersion": "17.0"
    },
    "android": {
      "minSdkVersion": 31
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "zuchiangmai.com",
          "pathPrefix": ["/health/s/", "/health/d/"],
          "appLink": true
        }
      ]
    }
  }
}
