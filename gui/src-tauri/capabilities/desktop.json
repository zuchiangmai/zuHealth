{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop only: drag the window by its title area (double-click zooms), zoom keys, the dock badge, and the native open/save dialogs.",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-badge-count",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
