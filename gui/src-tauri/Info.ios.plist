<!-- Merged into the iOS app's Info.plist by Tauri: why the app asks for each permission (declared ahead of use), and
     push notifications in the background. Keep gen/apple/project.yml and its Info.plist the same. -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Sync health data directly with your other devices on the same network.</string>
  <key>NSCameraUsageDescription</key>
  <string>Scan a lab device's code or another device's link code, and photograph lab reports.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Choose photos of lab reports for Health to read on this device.</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Connect to health devices such as scales and blood pressure monitors.</string>
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
  </array>
</dict>
</plist>
